# Thư mục lưu toàn bộ dữ liệu agent trong pbra.json
PBRA_DATA_DIR=

# Đường dẫn events.yaml; để trống sẽ dò cạnh file chạy và thư mục hiện tại
PBRA_EVENTS_FILE=

# Thu thập command line; luôn che giá trị có dạng mật khẩu/token khi chuẩn hóa
PBRA_COLLECT_CMDLINE=true
PBRA_REDACT_CMDLINE=true

# Chu kỳ lấy snapshot dự phòng và kích thước hàng đợi
PBRA_SNAPSHOT_SECONDS=30
PBRA_QUEUE_SIZE=1024

# Giữ dữ liệu trên file JSON duy nhất
PBRA_RAW_RETENTION_DAYS=14
PBRA_NORM_RETENTION_DAYS=30
PBRA_RESOLVED_RETENTION_DAYS=90

# Theo dõi cả kết quả risk mức medium
PBRA_TRACK_MEDIUM=true
PBRA_RISK_LOW=1
PBRA_RISK_MEDIUM=40
PBRA_RISK_HIGH=70
PBRA_RISK_CRITICAL=85

# Danh sách cổng cần xem xét thêm, phân cách bằng dấu phẩy
PBRA_SUSPICIOUS_PORTS=4444,1337,5555,6666,31337
